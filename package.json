{
  "name": "problem-intelligence-engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "score": "node packages/scoring/score.mjs",
    "llm:check": "node --env-file-if-exists=.env packages/agents/check-config.mjs",
    "llm:batch": "node --env-file-if-exists=.env packages/agents/batch-llm.mjs",
    "llm:verified": "PIE_LLM_PROVIDER=openrouter PIE_LLM_MODEL=nvidia/nemotron-3.5-lightning:free PIE_LLM_VERIFY=1 node --env-file-if-exists=.env packages/agents/batch-llm.mjs",
    "db:migrate": "node packages/storage/migrate.mjs",
    "llm:import": "node packages/storage/model-runs.mjs",
    "llm:graph": "node packages/agents/graph-report.mjs",
    "threads:ingest": "node packages/ingestion/conversations.mjs",
    "embeddings:run": "node packages/agents/embed.mjs",
    "corroboration:run": "node --env-file-if-exists=.env packages/agents/corroborate.mjs",
    "threads:review": "node --env-file-if-exists=.env packages/agents/comment-support.mjs",
    "corroboration:evaluate": "node --env-file-if-exists=.env packages/agents/evaluate-corroboration.mjs",
    "problems:search": "node packages/agents/search-problems.mjs",
    "discover:search": "node packages/ingestion/targeted.mjs",
    "discovery:cycle": "node --env-file-if-exists=.env packages/agents/discovery-cycle.mjs",
    "problems:dossier": "node packages/agents/dossier.mjs",
    "eval:prepare-holdout": "node packages/agents/holdout.mjs",
    "eval:review-holdout": "node packages/agents/holdout-review.mjs",
    "recurrence:research": "node --env-file-if-exists=.env packages/agents/recurrence-research.mjs",
    "audit:provenance": "node packages/agents/audit-provenance.mjs",
    "eval:quality-gate": "node packages/agents/holdout-quality.mjs",
    "eval:annotation-ui": "node packages/agents/annotation-ui.mjs",
    "eval:embedding-retrieval": "node packages/agents/evaluate-embeddings.mjs",
    "eval:compare-embeddings": "node packages/agents/compare-embeddings.mjs",
    "research:alternate-pairs": "node packages/agents/mine-alternate-pairs.mjs",
    "research:review-alternate": "node --env-file-if-exists=.env packages/agents/review-alternate-pairs.mjs"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
