# Copy to .env and fill in one key. .env is gitignored; never commit real secrets.
#
# LLM provider. One of: openai | openrouter | custom
# All three speak the OpenAI chat-completions API.
PIE_LLM_PROVIDER=openrouter

# Explicit key. Highest precedence. Leave empty to fall back to the provider key var.
PIE_LLM_API_KEY=

# Model id, provider-specific. OpenRouter needs the "vendor/model" prefix.
PIE_LLM_MODEL=nvidia/nemotron-3.5-lightning:free

# Override the endpoint. Required when PIE_LLM_PROVIDER=custom.
# PIE_LLM_BASE_URL=https://api.openai.com/v1/chat/completions

# Provider key vars, read only when PIE_LLM_API_KEY is empty.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Jev / TypeSafe is NOT supported here and has no variable in this file.
# Its API returns typed noul/choice/score judgements, not the grounded JSON
# extraction with a verbatim evidence quote that packages/agents/llm.mjs validates.

# GitHub connector token, optional (raises rate limits).
GITHUB_TOKEN=

# Database. Defaults apply when unset.
# PGDATABASE=problem_intelligence
# PGHOST=
# PGUSER=
# PGPASSWORD=

# Ingestion knobs.
# PIE_GITHUB_REPOS=nodejs/node
# PIE_HN_LIMIT=10
